<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#F6F7F9">
<title>Cooling Necklace — 2030 Seoul Liquor &amp; Wine Expo</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+KR:wght@300;400;500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* =========================================================
   PROJECT 02 · COOLING NECKLACE
   무드: 밝은 회백 + 라벤더 + 붉은 간접광 / 냉각 블루
   ========================================================= */
:root{
  --bg:#F6F7F9; --paper:#EFEDF3; --paper2:#E6E2EE;
  --ink:#1d1b22; --sub:#6c6875; --mute:#a8a4b0; --line:rgba(29,27,34,.1);
  --lav:#8a7fb8; --lav-d:#6f63a3; --lav-soft:#ece9f6;
  --red:#ff4b4b; --ice:#3fb6ff;
  --night:#16141c; --ntext:#f2f0f7; --nsub:rgba(242,240,247,.56); --nline:rgba(242,240,247,.14);
  --pad:clamp(20px,6vw,96px);
  --ease:cubic-bezier(.22,.8,.22,1); --ease-io:cubic-bezier(.65,0,.35,1);
  --serif:"Inter","IBM Plex Sans KR",system-ui,sans-serif; --sans:"Inter","IBM Plex Sans KR",system-ui,sans-serif; --mono:"Inter","IBM Plex Sans KR",system-ui,sans-serif;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:17px;line-height:1.65;letter-spacing:-.01em;word-break:keep-all;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;cursor:pointer}
img{display:block;max-width:100%}
.mono,.eyebrow{font-family:var(--mono);font-size:11.5px;font-weight:500;letter-spacing:.14em;text-transform:uppercase;color:var(--sub)}
.eyebrow{margin:0 0 22px}
.h2{margin:0;font-family:var(--serif);font-weight:400;font-size:clamp(42px,5.8vw,92px);line-height:1;letter-spacing:-.015em}
.h2 em{font-style:italic;color:var(--lav)}
.lead{margin:28px 0 0;max-width:33em;font-size:clamp(16px,1.3vw,20px);line-height:1.75;color:var(--sub)}
.night{background:var(--night);color:var(--ntext)}
.night .eyebrow,.night .mono{color:var(--nsub)}
.night .h2 em{color:#b9aee6}

/* ---------- header ---------- */
.progress{position:fixed;inset:0 0 auto 0;height:2px;z-index:60;pointer-events:none}
.progress i{display:block;height:100%;background:var(--lav);transform-origin:0 50%;transform:scaleX(0)}
.hd{position:fixed;top:0;left:0;right:0;z-index:50;height:68px;padding:0 var(--pad);display:flex;align-items:center;justify-content:space-between;gap:24px;transition:color .4s,background .4s,transform .5s var(--ease)}
.hd.is-light{background:rgba(246,247,249,.8);backdrop-filter:blur(14px) saturate(1.4);-webkit-backdrop-filter:blur(14px) saturate(1.4);box-shadow:0 1px 0 var(--line)}
.hd.is-dark{color:var(--ntext);background:rgba(22,20,28,.6);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.hd.is-hide{transform:translateY(-100%)}
.logo{font-family:var(--mono);font-size:12px;font-weight:600;letter-spacing:.18em}
.nav{display:flex;gap:4px}
.nav a{padding:8px 14px;border-radius:99px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;opacity:.6;transition:opacity .3s,box-shadow .3s}
.nav a:hover{opacity:1}
.nav a.is-on{opacity:1;box-shadow:inset 0 0 0 1px currentColor}
.back{font-family:var(--mono);font-size:11px;letter-spacing:.14em;padding:9px 16px;border-radius:99px;background:var(--ink);color:#fff;transition:transform .3s var(--ease)}
.hd.is-dark .back{background:var(--ntext);color:var(--ink)}
.back:hover{transform:translateY(-1px)}

/* ---------- reveal ---------- */
.in-up{display:inline-block;opacity:0;transform:translateY(30px);transition:opacity 1.1s var(--ease) var(--d,0s),transform 1.2s var(--ease) var(--d,0s)}
.is-ready .in-up{opacity:1;transform:none}
.rv{opacity:0;transform:translateY(40px);transition:opacity 1s var(--ease),transform 1.1s var(--ease)}
.rv.is-in{opacity:1;transform:none}
.open{clip-path:inset(7% 6% round 44px);transition:clip-path 1.3s var(--ease)}
.open.is-in{clip-path:inset(0 0 round 32px)}

/* ---------- 3D common ---------- */
[data-stage]{position:relative;touch-action:pan-y}
[data-stage] canvas{position:absolute;inset:0;width:100%!important;height:100%!important;display:block;outline:none}
[data-stage].grab{cursor:grab}[data-stage].grab:active{cursor:grabbing}
.fallback{position:absolute;inset:0;display:grid;place-items:center}
.fallback img{height:86%;width:auto;max-width:none;mix-blend-mode:multiply}
.lab .fallback img{mix-blend-mode:normal;height:60%;border-radius:24px;opacity:.85}
.hero .fallback{left:48%;opacity:.9}
.has-3d .fallback{display:none}
.drag{position:absolute;left:22px;bottom:22px;z-index:2;margin:0;display:flex;align-items:center;gap:8px;padding:8px 13px 8px 11px;border-radius:99px;background:rgba(246,247,249,.75);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 0 0 1px var(--line);color:var(--sub);font-size:12.5px;font-weight:500;pointer-events:none;transition:opacity .6s,transform .6s var(--ease)}
.drag svg{color:var(--ink);animation:spinHint 3.2s var(--ease-io) infinite}
.drag.is-used{opacity:0;transform:translateY(6px)}
@keyframes spinHint{0%,55%{transform:rotate(0)}100%{transform:rotate(-360deg)}}

/* ---------- 01 hero ---------- */
.hero{position:relative;height:100vh;min-height:660px;overflow:hidden;background:radial-gradient(70% 60% at 68% 52%,#ffffff 0%,#eeebf6 45%,var(--bg) 100%)}
.hero-img{position:absolute;right:calc(var(--pad) + 4vw);top:84px;bottom:24px;display:flex;align-items:center;justify-content:center;pointer-events:none}
.hero-img img{height:100%;width:auto;max-width:none;mix-blend-mode:multiply;opacity:0;transform:translateY(24px);transition:opacity 1.4s var(--ease) .3s,transform 1.6s var(--ease) .3s}
.is-ready .hero-img img{opacity:1;transform:none}
@media (max-width:980px){.hero-img{left:0;right:0;top:70px;bottom:40%;opacity:.95}}
.hero-copy{position:absolute;left:var(--pad);bottom:clamp(56px,11vh,120px);z-index:2;pointer-events:none;max-width:56vw}
.title{margin:0;font-family:var(--serif);font-weight:400;font-size:clamp(64px,10.5vw,184px);line-height:.88;letter-spacing:-.02em}
.title .ln{display:block;overflow:hidden;padding-bottom:.06em}
.title em{font-style:italic;color:var(--lav)}
.hero-lead{margin:28px 0 0;font-size:clamp(16px,1.35vw,21px);line-height:1.7;color:#4a4654;max-width:30em}
.hero-tag{position:absolute;left:var(--pad);top:110px;z-index:2}
.scroll{position:absolute;right:var(--pad);bottom:clamp(56px,11vh,120px);z-index:2;display:flex;flex-direction:column;align-items:center;gap:12px;font-family:var(--mono);font-size:10.5px;letter-spacing:.16em;color:var(--sub)}
.scroll i{width:1px;height:64px;background:var(--line);position:relative;overflow:hidden}
.scroll i::after{content:"";position:absolute;left:0;top:-40%;width:1px;height:40%;background:var(--lav);animation:drop 2.2s var(--ease-io) infinite}
@keyframes drop{to{top:100%}}
.hero-state{position:absolute;right:var(--pad);top:110px;z-index:2;display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;color:var(--sub)}
.hero-state b{width:8px;height:8px;border-radius:50%;background:#bdb8c7;transition:background .5s,box-shadow .5s}

/* ---------- 02 story (pinned) ---------- */
.story{height:520vh;position:relative}
.story-pin{position:sticky;top:0;height:100vh;overflow:hidden;background:var(--night)}
.story-media{position:absolute;inset:0}
.story-media img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.08);transition:opacity 1.1s var(--ease),transform 6s ease-out}
.story-media img.is-on{opacity:.55;transform:scale(1)}
.story-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(22,20,28,.85) 0%,rgba(22,20,28,.35) 70%,rgba(22,20,28,.2) 100%)}
.story-lines{list-style:none;margin:0;padding:0;position:absolute;inset:0;z-index:2;color:var(--ntext)}
.story-lines li{position:absolute;left:var(--pad);right:var(--pad);top:50%;transform:translateY(-40%);font-family:var(--serif);font-size:clamp(38px,5.6vw,92px);line-height:1.08;letter-spacing:-.01em;opacity:0;filter:blur(14px);transition:opacity .9s var(--ease),transform 1.1s var(--ease),filter .9s var(--ease);max-width:16em}
.story-lines li small{display:block;margin-bottom:26px;font-family:var(--mono);font-size:11.5px;letter-spacing:.14em;color:var(--nsub)}
.story-lines li em{font-style:italic;color:#c4b9f0}
.story-lines li em.r{color:#ff8a8a}
.story-lines li.is-on{opacity:1;filter:none;transform:translateY(-50%)}
.story-lines li.is-past{transform:translateY(-62%)}
.story-dots{position:absolute;right:var(--pad);top:50%;transform:translateY(-50%);display:grid;gap:10px;z-index:2}
.story-dots i{width:6px;height:6px;border-radius:50%;background:var(--nline);transition:background .4s,transform .4s var(--ease)}
.story-dots i.is-on{background:#c4b9f0;transform:scale(1.5)}

/* ---------- 03 why ---------- */
.why{padding:26vh var(--pad) 22vh;max-width:1500px;margin:0 auto}
.read{margin:0;font-size:clamp(28px,3.4vw,54px);line-height:1.4;font-weight:600;letter-spacing:-.035em}
.read span{color:rgba(29,27,34,.14);transition:color .5s}
.read span.on{color:var(--ink)}
.read span.on.k{color:var(--lav)}
.why-pair{margin-top:15vh;display:grid;grid-template-columns:1fr 1fr;border-top:1px solid var(--line)}
.why-pair a{padding:30px 0 0;display:grid;gap:6px}
.why-pair a+a{padding-left:40px;border-left:1px solid var(--line)}
.why-pair b{font-size:clamp(22px,2vw,30px);font-weight:600;letter-spacing:-.03em}
.why-pair span{color:var(--sub);font-size:15.5px}
.why-pair a:hover b{color:var(--lav)}

/* ---------- section head ---------- */
.sec-hd{padding:20vh var(--pad) 8vh;max-width:1500px;margin:0 auto}

/* ---------- pins / info / tools (shared) ---------- */
.pins{position:absolute;inset:0;pointer-events:none;z-index:2}
.pin{position:absolute;left:0;top:0;width:34px;height:34px;margin:-17px 0 0 -17px;border:0;padding:0;border-radius:50%;background:transparent;pointer-events:auto;transition:opacity .4s}
.pin::before{content:"";position:absolute;inset:10px;border-radius:50%;background:#fff;box-shadow:0 0 0 3px rgba(22,20,28,.5);transition:background .3s,inset .3s var(--ease)}
.pin::after{content:"";position:absolute;inset:0;border-radius:50%;border:1.5px solid #fff;opacity:.6;animation:ring 2.6s var(--ease) infinite}
.pin span{position:absolute;left:34px;top:50%;transform:translate(6px,-50%);white-space:nowrap;font-size:12.5px;font-weight:600;padding:5px 10px;border-radius:99px;background:rgba(255,255,255,.94);color:var(--ink);opacity:0;transition:opacity .3s,transform .3s var(--ease);pointer-events:none}
.pin:hover span,.pin.is-on span{opacity:1;transform:translate(0,-50%)}
.pin:hover::before,.pin.is-on::before{background:#c4b9f0;inset:7px}
.pin.is-off,.pin.is-gone{opacity:0;pointer-events:none}
.pin.is-dim{opacity:.35}
@keyframes ring{0%{transform:scale(.5);opacity:.6}100%{transform:scale(1.35);opacity:0}}
.info{position:absolute;right:var(--pad);top:50%;transform:translateY(-50%);z-index:3;width:min(360px,30vw);padding:30px 30px 26px;border-radius:24px;background:rgba(255,255,255,.86);color:var(--ink);backdrop-filter:blur(18px) saturate(1.4);-webkit-backdrop-filter:blur(18px) saturate(1.4);box-shadow:0 30px 60px -30px rgba(0,0,0,.5)}
.info>*{transition:opacity .35s,transform .45s var(--ease)}
.info.is-swap>*{opacity:0;transform:translateY(8px)}
.info-no{margin:0 0 12px;font-family:var(--mono);font-size:11px;letter-spacing:.14em;color:var(--lav)}
.info h3{margin:0 0 14px;font-size:24px;font-weight:600;letter-spacing:-.035em;line-height:1.3}
.info h3 small{display:block;margin-top:4px;font-family:var(--mono);font-size:10.5px;font-weight:500;letter-spacing:.14em;color:var(--sub)}
.info p{margin:0;color:var(--sub);font-size:15px;line-height:1.75}
.info-act{display:flex;flex-wrap:wrap;gap:8px;margin-top:18px}
.info-act:empty{display:none}
.info-act button{border:0;height:38px;padding:0 16px;border-radius:99px;background:var(--ink);color:#fff;font-size:13.5px;font-weight:600}
.tools{position:absolute;left:50%;bottom:24px;transform:translateX(-50%);z-index:3;display:flex;align-items:center;gap:8px;padding:8px;border-radius:99px;background:rgba(255,255,255,.88);color:var(--ink);backdrop-filter:blur(16px) saturate(1.4);-webkit-backdrop-filter:blur(16px) saturate(1.4);box-shadow:0 20px 50px -24px rgba(0,0,0,.5);white-space:nowrap}
.seg{display:flex;padding:3px;border-radius:99px;background:rgba(29,27,34,.06)}
.seg button{border:0;background:none;padding:9px 14px;border-radius:99px;font-size:13px;font-weight:600;color:var(--sub);transition:background .3s,color .3s}
.seg button.is-on{background:#fff;color:var(--ink);box-shadow:0 2px 8px -2px rgba(29,27,34,.2)}
.ico{height:38px;padding:0 14px;border:0;border-radius:99px;background:rgba(29,27,34,.06);font-size:13px;font-weight:600}
.ico[aria-pressed="true"]{background:var(--ink);color:#fff}
#bLight[aria-pressed="true"]{background:var(--ink);color:#fff}
.alc em{min-width:3.4em;font-weight:700}
.zoom{display:flex;gap:2px}
.zoom button{width:38px;height:38px;border:0;border-radius:50%;background:rgba(29,27,34,.06);font-size:18px;line-height:1}

/* ---------- 04 light lab ---------- */
.lab{position:relative;height:100vh;min-height:720px;overflow:hidden;background:radial-gradient(60% 65% at 50% 45%,#3b3352 0%,#221d2c 55%,var(--night) 100%)}
.lab-view{position:absolute;inset:0}
.lab-view canvas{touch-action:none}
.lab-head{position:absolute;left:var(--pad);top:110px;z-index:3;max-width:26em}
.lab-sub{margin:0;font-size:clamp(17px,1.4vw,21px);line-height:1.6;color:var(--ntext)}
.lab-sub b{color:#ff8a8a;font-weight:600}
.lab-tap{position:absolute;left:50%;top:50%;z-index:2;margin:0 0 0 70px;display:flex;align-items:center;gap:8px;font-size:12.5px;font-weight:600;color:var(--ntext);pointer-events:none;transition:opacity .6s}
.lab-tap i{width:14px;height:14px;border-radius:50%;background:#ff8a8a;box-shadow:0 0 0 0 rgba(255,138,138,.6);animation:tapP 1.6s infinite}
@keyframes tapP{70%{box-shadow:0 0 0 14px rgba(255,138,138,0)}}
.lab-tap.is-used{opacity:0}
.lab-state{position:absolute;left:var(--pad);bottom:110px;z-index:3;display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;color:var(--ntext)}
.lab-state b{width:9px;height:9px;border-radius:50%;background:#9f97b5;transition:background .4s,box-shadow .4s}
.neck{background:radial-gradient(60% 65% at 50% 45%,#2b3a55 0%,#1b2033 55%,#121420 100%)}
.lab-sub b.ice,.ice{color:#8fd3ff}.lab-tap i.ice{background:#8fd3ff;box-shadow:0 0 0 0 rgba(143,211,255,.6)}
.neck .lab-tap{margin-left:120px;margin-top:-60px}
#bCool[aria-pressed="true"]{background:var(--ice);color:#fff}
.temp{display:flex;align-items:center;gap:10px;padding:0 10px 0 14px}.temp .mono{color:var(--sub)}.temp b{font-size:15px;font-variant-numeric:tabular-nums;width:4.2em}
.nm{display:none}.lab.mode-n .pm{display:none}.lab.mode-n .nm{display:block}.lab.mode-n .alc.pm{display:none}
#bCool[aria-pressed="true"]{background:var(--ice);color:#fff}
.lab-src{margin:14px 0 0;color:var(--nsub)}
.alc{display:flex;align-items:center;gap:10px;padding:0 10px 0 12px}
.alc .mono{color:var(--sub)}
.alc input{width:150px;accent-color:var(--red)}
.alc b{font-family:var(--mono);font-size:12px;width:36px}
.alc em{font-style:normal;font-family:var(--mono);font-size:10.5px;color:var(--mute)}
.drag{position:absolute;left:var(--pad);bottom:24px;z-index:2;margin:0;display:flex;align-items:center;gap:8px;padding:8px 13px 8px 11px;border-radius:99px;background:rgba(255,255,255,.12);color:var(--nsub);font-size:12.5px;font-weight:500;pointer-events:none;transition:opacity .6s}
.drag svg{color:var(--ntext);animation:spinHint 3.2s var(--ease-io) infinite}
.drag.is-used{opacity:0}
@keyframes spinHint{0%,55%{transform:rotate(0)}100%{transform:rotate(-360deg)}}

/* ---------- 05 views & spec ---------- */
.spec-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:6vw;padding:0 var(--pad) 22vh;max-width:1640px;margin:0 auto;align-items:start}
.draw{margin:0;position:sticky;top:100px;border-radius:28px;background:#fff;padding:78px 28px 28px;box-shadow:0 0 0 1px var(--line)}
.draw-tabs{position:absolute;left:24px;top:20px}
.draw-img{position:relative}
.draw-img img{width:100%;mix-blend-mode:multiply;transition:opacity .3s}
.draw-cap{display:grid;grid-template-columns:repeat(var(--n,5),1fr);gap:8px;margin-top:16px}
.draw-cap span{font-size:12.5px;color:var(--sub);text-align:center;padding-top:10px;border-top:1px solid var(--line)}
.spec-list{margin:0}
.spec-list>div{display:grid;grid-template-columns:7.5em 1fr;gap:18px;padding:20px 0;border-top:1px solid var(--line)}
.spec-list>div:last-child{border-bottom:1px solid var(--line)}
.spec-list dt{font-family:var(--mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--sub);padding-top:5px}
.spec-list dd{margin:0;font-size:18px;font-weight:600;letter-spacing:-.02em}
.spec-list small{display:block;margin-top:6px;font-size:14px;font-weight:400;color:var(--sub);letter-spacing:-.01em;line-height:1.7}

/* ---------- 06 scenario ---------- */
.scen{background:linear-gradient(var(--bg),var(--paper) 20%,var(--paper))}
.steps{display:grid;grid-template-columns:minmax(300px,1fr) 1.45fr;gap:0 4vw;padding:0 var(--pad);max-width:1640px;margin:0 auto}
.step-list{list-style:none;margin:0;padding:0 0 10vh}
.step-list li{min-height:92vh;display:flex;flex-direction:column;justify-content:center;opacity:.22;transition:opacity .6s var(--ease)}
.step-list li.is-on{opacity:1}
.step-list .n{font-family:var(--mono);font-size:11.5px;letter-spacing:.12em;color:var(--lav);margin-bottom:16px}
.step-list h3{margin:0 0 18px;font-family:var(--serif);font-weight:400;font-size:clamp(34px,3.2vw,52px);line-height:1.05;letter-spacing:-.01em}
.step-list h3 em{font-style:italic;color:var(--lav)}
.step-list p{margin:0;max-width:26em;color:var(--sub);font-size:16.5px;line-height:1.8}
.step-list .note{margin-top:18px;padding:12px 16px;border-left:2px solid var(--lav);background:var(--lav-soft);border-radius:0 12px 12px 0;font-size:14px;color:#4a4654;max-width:28em}
.step-list .thumb{display:none}
.stage{position:sticky;top:0;height:100vh}
.stage-box{position:absolute;inset:0;display:flex;flex-direction:column;justify-content:center;gap:14px;padding-top:40px}
.frame{position:relative;aspect-ratio:1.55/1;border-radius:28px;overflow:hidden;background:#ddd;box-shadow:0 40px 80px -40px rgba(60,40,90,.35)}
.scen-3d{position:absolute;inset:0;background:linear-gradient(#f4f1fa,#e4def0)}
.scen-picto{position:absolute;inset:0;transition:opacity .25s}.scen-picto svg{width:100%;height:100%;display:block}
.scen-3d.has-3d+.scen-picto{display:none}
.frame .stepno{position:absolute;left:22px;top:20px;font-family:var(--mono);font-size:11px;letter-spacing:.12em;padding:6px 12px;border-radius:99px;background:rgba(255,255,255,.88);backdrop-filter:blur(6px)}
.frame .stepno{z-index:2}.frame .big{position:absolute;right:22px;bottom:4px;z-index:2;font-family:var(--serif);font-style:italic;font-size:96px;line-height:1;color:rgba(138,127,184,.55);pointer-events:none}
.hud{display:grid;grid-template-columns:auto 1fr 1fr;gap:28px;align-items:center;background:#fff;border-radius:22px;padding:16px 22px;box-shadow:0 0 0 1px var(--line)}
.status{display:flex;align-items:center;gap:10px;font-weight:600;font-size:14.5px;min-width:11em}
.status .dot{width:9px;height:9px;border-radius:50%;background:#bdb8c7;transition:background .4s,box-shadow .4s}
.meter .mlab{display:flex;justify-content:space-between;margin-bottom:6px}
.meter .bar{height:6px;border-radius:6px;background:#f0eef3;overflow:hidden}
.meter .bar i{display:block;height:100%;width:0;border-radius:6px;transition:width 1s var(--ease),background .6s}
.ticks{display:grid;grid-template-columns:repeat(12,1fr);gap:4px}
.ticks i{height:3px;border-radius:3px;background:var(--line);transition:background .4s}
.ticks i.is-on{background:var(--ink)}

/* ---------- 07 system (night) — sticky title + vertical flow ---------- */
.sys{padding:22vh var(--pad) 18vh}
.sys-grid{display:grid;grid-template-columns:minmax(280px,.9fr) 1.2fr;gap:6vw;max-width:1500px;margin:0 auto;align-items:start}
.sys-head{position:sticky;top:18vh}
.sys-lead{margin:28px 0 0;max-width:24em;color:var(--nsub);font-size:clamp(16px,1.25vw,19px);line-height:1.75}
.flow{position:relative;list-style:none;margin:0;padding:0 0 0 0}
.flow-line{position:absolute;left:31px;top:32px;bottom:32px;width:2px;background:var(--nline)}
.flow-line i{position:absolute;inset:0;background:linear-gradient(#b9aee6,#ff5a78 55%,var(--ice));transform-origin:50% 0;transform:scaleY(0)}
.flow-col{position:relative;display:grid;grid-template-columns:64px 1fr;gap:28px;padding:0 0 12vh}
.flow-col:last-child{padding-bottom:0}
.node{width:64px;height:64px;border-radius:50%;display:grid;place-items:center;background:var(--night);box-shadow:0 0 0 1.5px var(--nline);color:var(--nsub);transition:box-shadow .6s,color .6s,background .6s;position:relative;z-index:1}
.node svg{width:30px;height:30px}
.flow-col.is-on .node{color:var(--ntext);background:#241f30;box-shadow:0 0 0 1.5px #b9aee6,0 0 0 10px rgba(185,174,230,.12)}
.flow-body{padding-top:6px;opacity:.35;transform:translateY(16px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.flow-col.is-on .flow-body{opacity:1;transform:none}
.flow-body h3{margin:12px 0 12px;font-size:clamp(26px,2.4vw,38px);font-weight:700;letter-spacing:-.04em;line-height:1.15}
.flow-body p{margin:0;color:var(--nsub);max-width:30em;font-size:16.5px;line-height:1.75}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
.chips span{display:inline-flex;align-items:center;gap:8px;padding:8px 14px;border-radius:99px;background:rgba(242,240,247,.06);box-shadow:0 0 0 1px var(--nline);font-size:13.5px;color:var(--ntext)}
.chips i{width:9px;height:9px;border-radius:50%;flex:none}
.sig-strip{max-width:1500px;margin:16vh auto 0;padding-top:40px;border-top:1px solid var(--nline)}
.sig-title{margin:0 0 22px}
.signals{display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative}
.sigc{position:relative;padding:22px 26px 22px 0}
.sigc+.sigc{padding-left:26px;border-left:1px solid var(--nline)}
.sigc:not(:last-child)::after{content:"→";position:absolute;right:-9px;top:30px;z-index:1;font-size:15px;color:var(--nsub);background:var(--night);padding:0 2px}
.sigc .sw{height:46px;border-radius:12px;margin-bottom:18px;position:relative;overflow:hidden;background:rgba(242,240,247,.06)}
.sigc .sw::after{content:"";position:absolute;left:50%;top:-30%;width:70%;height:90%;transform:translateX(-50%);border-radius:50%;filter:blur(14px)}
.sigc.idle .sw::after{background:rgba(242,240,247,.18)}
.sigc.warn .sw::after{background:#ff8fc0;animation:warn3 4.5s ease-in-out infinite}
@keyframes warn3{0%,20%{background:#ff8fc0}40%,55%{background:#ff5a78}75%,100%{background:#ff2424}}
.sigc.breath .sw::after{background:#b9aee6;animation:pulse 1s ease-in-out infinite}
.sigc.cool .sw::after{top:auto;bottom:-30%;background:var(--ice);animation:pulse 2.4s ease-in-out infinite}
@keyframes pulse{50%{opacity:.4}}
.sigc b{display:block;font-size:16px;font-weight:600}
.sigc small{display:block;margin-top:4px;color:var(--nsub);font-size:13.5px;line-height:1.6}

