  const vents=[];for(let i=-6;i<=6;i++){const t=i*3.1*D2R;const o=new THREE.Object3D();o.position.set(mid*Math.sin(t),NH/2+2,NR-mid*Math.cos(t));g.add(o);vents.push(o)}
